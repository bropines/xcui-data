{
  "$schema": "../../schema/client-app.schema.json",
  "id": "throne-desktop",
  "name": "Throne (desktop)",
  "family": "xray",
  "platforms": ["windows", "linux", "macos"],
  "openSource": true,
  "repo": "github.com/throneproj/Throne",
  "brandIcon": "Throne",
  "latest": [
    { "version": "1.3.2", "date": "2026-09-29" },
    { "version": "1.4.0-beta.4", "date": "2026-10-23", "channel": "pre" }
  ],
  "cores": [
    { "kind": "sing-box", "version": "~1.14 fork", "src": ["gomod"] },
    { "kind": "xray", "version": "fork based on v26.9.9", "note": "no MASQUE/xdrive", "src": ["gomod"] }
  ],
  "uaPatterns": [
    {
      "regex": "^throne/\\d",
      "example": "Throne/1.3.2",
      "note": "version cut at the first \"-\": 1.4.0-beta.4 sends Throne/1.4.0",
      "src": ["ua", "ci"]
    },
    {
      "minVersion": "1.2.0",
      "regex": "^throne/1\\.(?:[2-9]|[1-9]\\d+)(?:\\.|$)|^throne/(?:[2-9]|[1-9]\\d+)(?:\\.|$)",
      "example": "Throne/1.2.4",
      "src": ["arr", "op"]
    },
    {
      "maxVersion": "1.1.0-beta.1",
      "regex": "^throne/1\\.[01]\\.\\d+ \\(prefer clashmeta format\\)",
      "example": "Throne/1.0.13 (Prefer ClashMeta Format)",
      "src": ["ua0"]
    }
  ],
  "uaOverridable": "global+per-subscription",
  "requestHeaders": [
    { "name": "x-hwid", "value": "device id", "when": "default-off", "src": ["hwid"] },
    { "name": "x-device-os", "value": "OS name", "when": "default-off", "src": ["hwid"] },
    { "name": "x-ver-os", "value": "OS version", "when": "default-off", "src": ["hwid"] },
    { "name": "x-device-model", "value": "model", "when": "default-off", "src": ["hwid"] }
  ],
  "accepts": ["XRAY_JSON", "XRAY_BASE64", "CLASH", "SINGBOX"],
  "best": "XRAY_JSON",
  "bestWhy": {
    "text": "≥1.2: an array becomes one Custom Xray Config per element, named from remarks; balancers and dialerProxy run unchanged. A single object is split into outbounds.",
    "src": ["arr", "gen", "op"]
  },
  "gates": [
    {
      "type": "XRAY_JSON",
      "minVersion": "1.2.0",
      "regex": "^throne/1\\.(?:[2-9]|[1-9]\\d+)(?:\\.|$)|^throne/(?:[2-9]|[1-9]\\d+)(?:\\.|$)",
      "severity": "error",
      "note": "desktop 1.1.x and older has no array parser: an Xray JSON array does not import",
      "src": ["arr"]
    }
  ],
  "capabilities": {
    "balancer": true,
    "observatory": true,
    "routing": true,
    "xhttp": true,
    "reality": true,
    "vision": true,
    "vlessEncryption": true,
    "hysteria2": true,
    "wireguard": true,
    "finalmask": true,
    "tun": true,
    "masque": false
  },
  "capabilitiesSrc": ["gomod", "gen"],
  "headersRead": [
    { "name": "subscription-userinfo", "src": ["hdr"] },
    {
      "name": "profile-update-interval",
      "format": "hours (h/d/s suffix tolerated); fallback x-profile-update-interval",
      "src": ["hdr"]
    },
    { "name": "profile-title", "format": "plain|base64:", "src": ["hdr"] },
    { "name": "announce", "format": "plain|base64:", "src": ["hdr"] },
    { "name": "profile-web-page-url", "src": ["hdr"] },
    { "name": "support-url", "src": ["hdr"] }
  ],
  "deepLinks": [
    {
      "template": "throne://addsub/{B64:URL#NAME}",
      "note": "OS scheme registered on Windows/Linux since 1.3.0",
      "src": ["dl"]
    }
  ],
  "limits": [
    { "text": "the inbounds of a full config are removed; Throne adds its own bridge inbound", "src": ["gen"] }
  ],
  "pitfalls": [
    { "text": "desktop ≤1.1.x has no array parser: give it base64", "src": ["arr"] },
    { "text": "fallback HWID \"hostname-productType\" may fail the panel HWID regex", "src": ["dev"] },
    { "text": "1.0.x UA contains \"ClashMeta\"; only anchored clash rules are safe", "src": ["ua0"] }
  ],
  "sources": {
    "ua": { "ref": "throneproj/Throne@1.3.2:src/database/SettingsRepo.cpp:352-361", "kind": "source" },
    "ci": { "ref": "throneproj/Throne@1.3.2:.github/workflows/build.yml:242", "kind": "source" },
    "ua0": { "ref": "throneproj/Throne@1.0.13:src/global/Configs.cpp:347", "kind": "source" },
    "hwid": {
      "ref": "throneproj/Throne@1.3.2:src/configs/sub/GroupUpdater.cpp:45-70,389-414; include/database/SettingsRepo.h:161",
      "kind": "source"
    },
    "dev": { "ref": "throneproj/Throne@1.3.2:src/global/DeviceDetailsHelper.cpp:135-178", "kind": "source" },
    "arr": {
      "ref": "throneproj/Throne@1.3.2:src/configs/sub/SubscriptionParser.cpp:115-137,394-414 (first in 1.2.0-beta.5)",
      "kind": "source"
    },
    "gen": { "ref": "throneproj/Throne@1.3.2:src/configs/generate.cpp:2493-2501", "kind": "source" },
    "hdr": { "ref": "throneproj/Throne@1.3.2:src/configs/sub/GroupUpdater.cpp:208-224,590-660", "kind": "source" },
    "dl": { "ref": "throneproj/Throne@1.3.2:src/ui/mainWindow/mainwindow_deeplink.cpp:117-156", "kind": "source" },
    "gomod": { "ref": "throneproj/Throne@1.3.2:core/go.mod:13-25", "kind": "source" },
    "op": { "ref": "operator production Response Rules (private), 2026-10", "kind": "operator" }
  }
}
