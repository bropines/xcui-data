{
  "name": "xcui-data",
  "version": "0.1.0",
  "description": "The data the Xray Config UI Editor reads — client apps (User-Agents, formats, deep links, download links, logos) — as plain JSON, checked by CI and published to GitHub Pages.",
  "license": "MIT",
  "author": "bropines",
  "homepage": "https://github.com/bropines/xcui-data#readme",
  "repository": { "type": "git", "url": "git+https://github.com/bropines/xcui-data.git" },
  "bugs": { "url": "https://github.com/bropines/xcui-data/issues" },
  "keywords": ["xray", "remnawave", "subscription", "user-agent", "vpn-clients", "knowledge-base"],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./snapshot": { "types": "./dist/snapshot.d.ts", "import": "./dist/snapshot.js" },
    "./data.json": "./dist/data.json",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": ["dist", "schema", "README.md", "README.ru.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun scripts/build.ts",
    "check": "bun scripts/build.ts --check",
    "format": "bun scripts/format.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  }
}
